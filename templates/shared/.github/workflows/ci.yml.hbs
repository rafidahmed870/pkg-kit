name: CI on: push: branches: [main] pull_request: branches: [main] jobs: test: name: Test runs-on:
ubuntu-latest steps: - name: Checkout uses: actions/checkout@v4 - name: Setup Node.js uses:
actions/setup-node@v4 with: node-version: 20 {{#if (eq packageManager "pnpm")}} - name: Setup pnpm
uses: pnpm/action-setup@v3 with: version: 9 - name: Install dependencies run: pnpm install - name:
Run tests run: pnpm test - name: Build run: pnpm build {{else if (eq packageManager "yarn")}} -
name: Install dependencies run: yarn - name: Run tests run: yarn test - name: Build run: yarn build
{{else if (eq packageManager "bun")}} - name: Setup Bun uses: oven-sh/setup-bun@v1 - name: Install
dependencies run: bun install - name: Run tests run: bun test - name: Build run: bun run build
{{else}} - name: Install dependencies run: npm install - name: Run tests run: npm test - name: Build
run: npm run build {{/if}}
