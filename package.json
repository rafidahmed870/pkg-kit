{
  "name": "create-pkg-kit",
  "version": "0.1.0",
  "description": "A production-ready CLI for scaffolding modern npm packages with configurable language, package manager, testing framework, and npm metadata.",
  "homepage": "https://github.com/rafidahmed870/pkg-kit#readme",
  "bugs": {
    "url": "https://github.com/rafidahmed870/pkg-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafidahmed870/pkg-kit.git"
  },
  "license": "MIT",
  "author": "Rafid Ahmed",
  "type": "module",
  "bin": {
    "create-pkg-kit": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@clack/prompts": "0.9.1",
    "handlebars": "4.7.8",
    "minimist": "1.2.8"
  },
  "devDependencies": {
    "@types/handlebars": "4.1.0",
    "@types/minimist": "1.2.5",
    "@types/node": "20.14.0",
    "oxlint": "0.15.0",
    "prettier": "3.3.2",
    "tsup": "8.1.0",
    "typescript": "5.5.2",
    "vitest": "1.6.0"
  }
}
